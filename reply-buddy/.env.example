# Bearer token every client must send: Authorization: Bearer <token>
REPLY_BUDDY_TOKEN=change-me
PORT=8787

# A provider is enabled when its key is set.
OPENAI_API_KEY=
DEEPINFRA_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1-mini
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_MODELS=deepseek-ai/DeepSeek-V3,meta-llama/Llama-3.3-70B-Instruct

# Default provider/model when a request omits `model` (defaults: first enabled provider, its first model)
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-5-mini

# Origins allowed to call the API from a browser (comma-separated). Set to the extension origin,
# e.g. chrome-extension://<extension id> (see chrome://extensions). The paste-in page needs no entry.
ALLOWED_ORIGINS=

# SQLite file holding shared settings such as the style note (default: ./reply-buddy.sqlite).
# DATABASE_PATH=

# Folder of mode template files (default: server/modes). New files show up in GET /modes without a restart.
# MODES_DIR=
